---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

const { title = "BeTogether - Club de Pioneros" } = Astro.props;
const description = "Únete a BeTogether, el ecosistema omnicanal para emprendedores en Colombia. Transforma tu marca con logística internacional, tienda online y eventos en las ciudades mas importantes de Colombia.";
const siteUrl = "https://inscribete.betogether.com.co";
const ogImage = "/portada.jpg";
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <script is:inline> 
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PK9VPB4N');
    </script>

    <script is:inline>
      (() => {
        const loadClarity = () => {
          if (window.__betogetherClarityLoaded) return;
          window.__betogetherClarityLoaded = true;

          (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);
              t.async=1;
              t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];
              y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "vyrgxt7czl");
        };

        const scheduleClarity = () => {
          const startOnInteraction = () => {
            loadClarity();
          };

          window.addEventListener("pointerdown", startOnInteraction, { once: true });
          window.addEventListener("keydown", startOnInteraction, { once: true });
          window.addEventListener("touchstart", startOnInteraction, { once: true });

          window.setTimeout(loadClarity, 12000);
        };

        if (document.readyState === "complete") {
          scheduleClarity();
        } else {
          window.addEventListener("load", scheduleClarity, { once: true });
        }
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <style is:inline>
      :root {
        color-scheme: light;
      }
    </style>
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content="BeTogether, Emprendimiento Colombia, Ecommerce, Logística, Club de Pioneros, Vender Online, Festivales Bogotá" />
    <meta name="author" content="BeTogether COMPANY" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />

    <link
      rel="ard"
      href="/.well-known/ard.json"
      type="application/json"
    />
    <link
      rel="ai-catalog"
      href="/.well-known/ai-catalog.json"
      type="application/json"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/logobetogether.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=optional"
      rel="stylesheet"
      media="print" 
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=optional" rel="stylesheet" />
    </noscript>


    
  </head>

  <body class="landing-pioneros bg-background-light text-slate-900 antialiased">
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PK9VPB4N"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    
    <Header />
    
    <slot />


    <Footer />
  </body>
</html>