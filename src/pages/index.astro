---
// 1. VITAL: Activa el prerenderizado para que la landing sea ultra rápida
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Home/Hero.astro';
import Stats from '../components/Home/Stats.astro';
import Fase1 from '../components/Home/Fase1.astro';
import Ecosistema from '../components/Home/Ecosistema.astro';
import AfiliadoEstrella from '../components/Home/AfiliadoEstrella.astro';
import ComoEmpezar from '../components/Home/ComoEmpezar.astro';
import CtaGratis from '../components/Home/CtaGratis.astro';
import FAQ from '../components/Home/FAQ.astro';
import RegistroForm from '../components/Home/RegistroForm.astro';
---

<Layout title="BeTogether.com.co - Se un Pionero betogether en Colombia">
    <main class="pt-16 lg:pt-20 min-h-screen">
        <Hero />

        <Stats />

        <div
            class="[content-visibility:auto] [contain-intrinsic-size:auto_700px]"
        >
            <Fase1 />
        </div>

        <div
            class="[content-visibility:auto] [contain-intrinsic-size:auto_900px]"
        >
            <Ecosistema />
        </div>

        <div
            class="[content-visibility:auto] [contain-intrinsic-size:auto_800px]"
        >
            <AfiliadoEstrella />
        </div>

        <div
            class="[content-visibility:auto] [contain-intrinsic-size:auto_700px]"
        >
            <ComoEmpezar />
        </div>

        <div
            class="[content-visibility:auto] [contain-intrinsic-size:auto_600px]"
        >
            <CtaGratis />
        </div>

        <div
            class="[content-visibility:auto] [contain-intrinsic-size:auto_700px]"
        >
            <FAQ />
        </div>

        <div
            class="[content-visibility:auto] [contain-intrinsic-size:auto_300px]"
        >
            <RegistroForm />
        </div>
    </main>
</Layout>