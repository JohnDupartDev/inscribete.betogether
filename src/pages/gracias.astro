---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import {
    ArrowLeft,
    CheckCircle2,
} from "lucide-astro";
---

<Layout title="¡Gracias! | BeTogether">

    <!--
        Se conserva intacta la transferencia del event_id
        para deduplicación Browser + CAPI.
    -->
    <script is:inline>
        (() => {
            const storageKey =
                "betogether_meta_event_id";

            let metaEventId = "";

            try {
                metaEventId =
                    sessionStorage.getItem(
                        storageKey
                    ) || "";

                if (metaEventId) {
                    sessionStorage.removeItem(
                        storageKey
                    );
                }
            } catch (storageError) {
                console.warn(
                    "No fue posible leer el event_id temporal de Meta.",
                    storageError
                );
            }

            if (!metaEventId) {
                return;
            }

            window.dataLayer =
                window.dataLayer || [];

            window.dataLayer.push({
                event:
                    "betogether_registration_complete",
                meta_event_id:
                    metaEventId
            });
        })();
    </script>

    <main
        class="flex min-h-[80vh] items-center bg-white px-5 pb-20 pt-32 text-slate-900 md:px-6"
    >
        <div
            class="mx-auto w-full max-w-2xl text-center"
        >
            <div
                class="mx-auto mb-7 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-50"
            >
                <CheckCircle2
                    class="h-8 w-8 text-emerald-600"
                />
            </div>

            <p
                class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-[#b00089]"
            >
                Datos recibidos
            </p>

            <h1
                class="text-4xl font-extrabold leading-tight text-slate-950 md:text-6xl"
            >
                ¡Gracias!
            </h1>

            <p
                class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-slate-600 md:text-xl"
            >
                Pronto un asesor de BeTogether se comunicará contigo
                por WhatsApp para conocer tu negocio, resolver tus
                preguntas y contarte cómo podemos ayudarte.
            </p>

            <p
                class="mt-5 text-sm font-medium text-slate-500"
            >
                Mantente atento a tu teléfono.
            </p>

            <div class="mt-10">
                <a
                    href="/"
                    class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-200 bg-white px-6 py-3 text-sm font-bold text-slate-700 no-underline transition-all hover:border-slate-300 hover:bg-slate-50"
                >
                    <ArrowLeft class="h-4 w-4" />
                    Volver al inicio
                </a>
            </div>
        </div>
    </main>
</Layout>
