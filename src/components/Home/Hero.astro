---
import { ArrowRight } from "lucide-astro";
import LeadCaptureForm from "./LeadCaptureForm.astro";

const heroImage = "/portada-betogether.jpg";
const heroWebp480 = "/portada-betogether-480.webp";
const heroWebp800 = "/portada-betogether-800.webp";
---

<section
    class="relative flex min-h-[90vh] items-center overflow-hidden bg-background-dark pb-36 lg:min-h-screen lg:pt-16"
>
    <div class="absolute inset-0 z-0">
        <picture>
            <source
                type="image/webp"
                srcset={`${heroWebp480} 480w, ${heroWebp800} 800w`}
                sizes="100vw"
            />

            <img
                src={heroImage}
                width="800"
                height="549"
                alt="Emprendedor exitoso BeTogether"
                class="h-full w-full scale-100 object-cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
        </picture>

        <div class="absolute inset-0 z-10 bg-black/40"></div>
        <div class="hero-gradient absolute inset-0 z-20 opacity-80"></div>

        <div
            class="pointer-events-none absolute inset-0 z-30 opacity-30"
        >
            <div
                class="absolute left-10 top-20 h-64 w-64 animate-float rounded-full bg-primary blur-3xl will-change-transform"
            ></div>

            <div
                class="absolute bottom-20 right-10 h-96 w-96 animate-pulse-slow rounded-full bg-purple-600 blur-3xl will-change-transform"
            ></div>
        </div>
    </div>

    <div
        class="relative z-40 mx-auto w-full max-w-7xl px-5 sm:px-6"
    >
        <div
            class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,56%)_minmax(340px,44%)] lg:gap-10 xl:gap-14"
        >
            <div class="space-y-7 md:space-y-8">
                <div class="hidden animate-fade-in sm:inline-block">
                    <span
                        class="rounded-full border border-white/30 bg-white/20 px-4 py-2 text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md"
                    >
                        🚀 ¡Llegamos a Colombia! - Cupos limitados: 300 pioneros
                    </span>
                </div>

                <h1
                    class="max-w-4xl text-4xl font-extrabold leading-tight text-white drop-shadow-lg md:text-6xl lg:text-7xl"
                >
                    Tú creas la
                    <span class="gradient-text">marca</span>,
                    <br class="hidden md:block" />
                    nosotros ponemos
                    <span
                        class="text-primary underline decoration-4 underline-offset-8 decoration-white/30"
                    >
                        la Plataforma
                    </span>.
                </h1>

                <div
                    class="max-w-lg rounded-2xl border border-white/10 bg-white/10 p-6 text-base leading-relaxed text-slate-100 shadow-2xl backdrop-blur-md md:text-lg"
                >
                    <p>
                        <span
                            class="mb-2 block text-xl font-bold text-white md:text-2xl"
                        >
                            🚀 Oportunidad única:
                        </span>

                        Estamos buscando a los
                        <strong class="text-white">
                            primeros 300 emprendedores
                        </strong>
                        para transformar el comercio en Colombia.
                    </p>
                </div>

                <div class="pt-2">
                    <a
                        href="#pilares"
                        class="group inline-flex w-full items-center justify-center rounded-full border border-white/30 bg-white/10 px-8 py-4 text-center text-base font-bold text-white no-underline shadow-xl backdrop-blur-md transition-all hover:scale-105 hover:bg-white/20 sm:w-auto md:text-lg"
                    >
                        Conocer los beneficios
                        <ArrowRight
                            class="ml-2 h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
                        />
                    </a>
                </div>
            </div>

            <div
                class="mx-auto w-full max-w-md lg:mx-0 lg:ml-auto"
            >
                <LeadCaptureForm
                    instance="hero"
                    compact={true}
                />
            </div>
        </div>
    </div>

    <div class="wave-divider">
        <svg
            aria-hidden="true"
            class="fill-white transition-colors duration-500 dark:fill-background-dark"
            preserveAspectRatio="none"
            viewBox="0 0 1200 120"
        >
            <path
                d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V0C49.1,13.84,105.7,35.34,166,49.19,203.76,57.84,263.82,64.21,321.39,56.44Z"
            ></path>
        </svg>
    </div>
</section>

<style>
    .hero-gradient {
        background: linear-gradient(
            135deg,
            rgba(45, 27, 105, 0.95) 0%,
            rgba(16, 13, 15, 0.672) 100%
        );
    }

    .wave-divider {
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;
        overflow: hidden;
        line-height: 0;
        z-index: 50;
    }

    .wave-divider svg {
        position: relative;
        display: block;
        width: calc(150% + 1.3px);
        height: 80px;
    }

    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fade-in 0.8s ease-out forwards;
    }
</style>
