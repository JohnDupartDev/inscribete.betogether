---
import { ArrowRight } from "lucide-astro";
---

<section
    id="registro"
    class="relative border-y border-slate-200 bg-white py-10 md:py-12"
>
    <div
        class="mx-auto max-w-7xl px-5 sm:px-6"
    >
        <div
            class="grid items-center gap-6 lg:grid-cols-[minmax(220px,0.65fr)_minmax(0,1.35fr)] lg:gap-10"
        >
            <!-- COPY -->
            <div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.18em] text-[#b00089]"
                >
                    ¿Hablamos?
                </span>

                <h2
                    class="mt-2 text-2xl font-extrabold leading-tight text-slate-900 md:text-3xl"
                >
                    Descubre cómo BeTogether puede ayudarte
                </h2>

                <p
                    class="mt-2 max-w-md text-sm leading-relaxed text-slate-500 md:text-base"
                >
                    Déjanos tu contacto. Nosotros hacemos el resto.
                </p>
            </div>

            <!-- FORMULARIO MINIMALISTA -->
            <form
                class="w-full"
                data-betogether-lead-form
            >
                <div
                    class="grid gap-3 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]"
                >
                    <div>
                        <label
                            for="footer-nombre"
                            class="sr-only"
                        >
                            Nombre
                        </label>

                        <input
                            id="footer-nombre"
                            name="nombre"
                            type="text"
                            autocomplete="name"
                            required
                            minlength="2"
                            maxlength="120"
                            placeholder="Tu nombre"
                            class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none transition-all placeholder:text-slate-400 hover:border-slate-300 focus:border-[#ff00c8] focus:bg-white focus:ring-4 focus:ring-[#ff00c8]/10"
                        />
                    </div>

                    <div>
                        <label
                            for="footer-tel"
                            class="sr-only"
                        >
                            WhatsApp
                        </label>

                        <input
                            id="footer-tel"
                            name="tel"
                            type="tel"
                            inputmode="numeric"
                            autocomplete="tel"
                            required
                            minlength="10"
                            maxlength="10"
                            pattern="[0-9]{10}"
                            title="Ingresa un número celular colombiano de 10 dígitos."
                            placeholder="Tu WhatsApp"
                            class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-900 outline-none transition-all placeholder:text-slate-400 hover:border-slate-300 focus:border-[#ff00c8] focus:bg-white focus:ring-4 focus:ring-[#ff00c8]/10"
                        />
                    </div>

                    <button
                        type="submit"
                        data-submit-button
                        class="group flex h-12 items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-slate-900 px-6 text-sm font-bold text-white transition-all hover:bg-[#7000ff] disabled:cursor-not-allowed disabled:opacity-60"
                    >
                        <span data-submit-text>
                            Quiero saber más
                        </span>

                        <ArrowRight
                            class="h-4 w-4 transition-transform group-hover:translate-x-1"
                        />
                    </button>
                </div>

                <!-- Honeypot -->
                <div
                    class="absolute -left-[9999px] h-0 w-0 overflow-hidden"
                    aria-hidden="true"
                >
                    <label>
                        Empresa

                        <input
                            name="company"
                            type="text"
                            tabindex="-1"
                            autocomplete="off"
                        />
                    </label>
                </div>

                <div
                    class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between"
                >
                    <label
                        class="flex max-w-3xl cursor-pointer items-start gap-2"
                    >
                        <input
                            name="terms"
                            type="checkbox"
                            value="1"
                            required
                            class="mt-0.5 h-4 w-4 shrink-0 accent-[#ff00c8]"
                        />

                        <span
                            class="text-[11px] leading-relaxed text-slate-500 md:text-xs"
                        >
                            Acepto los
                            <a
                                href="/terminos-y-condiciones/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-semibold text-slate-700 underline underline-offset-2 hover:text-[#b00089]"
                            >
                                términos y condiciones
                            </a>
                            y la
                            <a
                                href="/terminos-y-condiciones/#privacidad"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-semibold text-slate-700 underline underline-offset-2 hover:text-[#b00089]"
                            >
                                política de privacidad
                            </a>.
                        </span>
                    </label>

                    <span
                        class="shrink-0 text-[11px] text-slate-400"
                    >
                        Sin spam. Solo queremos conocerte.
                    </span>
                </div>

                <div
                    data-form-message
                    class="mt-3 hidden rounded-lg px-3 py-2 text-sm font-medium"
                    role="status"
                    aria-live="polite"
                ></div>
            </form>
        </div>
    </div>
</section>
