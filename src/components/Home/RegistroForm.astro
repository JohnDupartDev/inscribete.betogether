---
import { ArrowRight } from "lucide-astro";
---

<section
    id="registro"
    class="relative overflow-hidden bg-gradient-to-b from-[#2b2150] to-[#241b3d] py-10 md:py-12"
>
    <div
        class="pointer-events-none absolute inset-0"
        aria-hidden="true"
    >
        <div
            class="absolute -left-24 top-1/2 h-64 w-64 -translate-y-1/2 rounded-full bg-[#ff00c8]/[0.06] blur-[100px]"
        ></div>

        <div
            class="absolute -right-24 top-1/2 h-72 w-72 -translate-y-1/2 rounded-full bg-[#7000ff]/[0.08] blur-[110px]"
        ></div>
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-5 sm:px-6">
        <div
            class="grid items-center gap-6 lg:grid-cols-[minmax(220px,0.65fr)_minmax(0,1.35fr)] lg:gap-10"
        >
            <!-- COPY -->
            <div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.18em] text-[#ff7de4]"
                >
                    ¿Hablamos?
                </span>

                <h2
                    class="mt-2 text-2xl font-extrabold leading-tight text-white md:text-3xl"
                >
                    Descubre cómo
                    <span class="text-[#ff67de]">BeTogether</span>
                    puede ayudarte
                </h2>

                <p
                    class="mt-2 max-w-md text-sm leading-relaxed text-white/70 md:text-base"
                >
                    Déjanos tu contacto. Nosotros hacemos el resto.
                </p>
            </div>

            <!-- FORMULARIO -->
            <form
                class="w-full"
                data-betogether-lead-form
            >
                <div
                    class="grid gap-3 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]"
                >
                    <div>
                        <label for="footer-nombre" class="sr-only">
                            Nombre
                        </label>

                        <input
                            id="footer-nombre"
                            name="nombre"
                            type="text"
                            autocomplete="name"
                            required
                            minlength="2"
                            maxlength="120"
                            placeholder="Tu nombre"
                            class="h-12 w-full rounded-xl border border-white/10 bg-white/[0.08] px-4 text-sm text-white outline-none transition-all placeholder:text-white/35 hover:border-white/20 focus:border-[#ff54da] focus:bg-white/[0.10] focus:ring-4 focus:ring-[#ff00c8]/10"
                        />
                    </div>

                    <div>
                        <label for="footer-tel" class="sr-only">
                            WhatsApp
                        </label>

                        <input
                            id="footer-tel"
                            name="tel"
                            type="tel"
                            inputmode="numeric"
                            autocomplete="tel"
                            required
                            minlength="10"
                            maxlength="10"
                            pattern="[0-9]{10}"
                            title="Ingresa un número celular colombiano de 10 dígitos."
                            placeholder="Tu WhatsApp"
                            class="h-12 w-full rounded-xl border border-white/10 bg-white/[0.08] px-4 text-sm text-white outline-none transition-all placeholder:text-white/35 hover:border-white/20 focus:border-[#ff54da] focus:bg-white/[0.10] focus:ring-4 focus:ring-[#ff00c8]/10"
                        />
                    </div>

                    <button
                        type="submit"
                        data-submit-button
                        class="group flex h-12 items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-gradient-to-r from-[#ff00c8] to-[#7000ff] px-6 text-sm font-bold text-white transition-all hover:opacity-95 disabled:cursor-not-allowed disabled:opacity-60"
                    >
                        <span data-submit-text>
                            Quiero saber más
                        </span>

                        <ArrowRight
                            class="h-4 w-4 transition-transform group-hover:translate-x-1"
                        />
                    </button>
                </div>

                <!-- Honeypot -->
                <div
                    class="absolute -left-[9999px] h-0 w-0 overflow-hidden"
                    aria-hidden="true"
                >
                    <label>
                        Empresa
                        <input
                            name="company"
                            type="text"
                            tabindex="-1"
                            autocomplete="off"
                        />
                    </label>
                </div>

                <div
                    class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between"
                >
                    <label
                        class="flex max-w-3xl cursor-pointer items-start gap-2"
                    >
                        <input
                            name="terms"
                            type="checkbox"
                            value="1"
                            required
                            class="mt-0.5 h-4 w-4 shrink-0 accent-[#ff00c8]"
                        />

                        <span
                            class="text-[11px] leading-relaxed text-white/60 md:text-xs"
                        >
                            Acepto los
                            <a
                                href="/terminos-y-condiciones/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-semibold text-[#ff9ae8] underline underline-offset-2 hover:text-white"
                            >
                                términos y condiciones
                            </a>
                            y la
                            <a
                                href="/terminos-y-condiciones/#privacidad"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-semibold text-[#ff9ae8] underline underline-offset-2 hover:text-white"
                            >
                                política de privacidad
                            </a>.
                        </span>
                    </label>

                    <span class="shrink-0 text-[11px] text-white/35">
                        Sin spam. Solo queremos conocerte.
                    </span>
                </div>

                <div
                    data-form-message
                    class="mt-3 hidden rounded-lg border border-white/10 bg-white/[0.06] px-3 py-2 text-sm font-medium text-white"
                    role="status"
                    aria-live="polite"
                ></div>
            </form>
        </div>
    </div>
</section>