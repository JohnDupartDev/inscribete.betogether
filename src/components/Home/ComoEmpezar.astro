---
/* Componente: Cómo Empezar - BeTogether */

import {
  Play,
  X,
} from "lucide-astro";

const videoId = "L_pWSYQI04g";
const videoEmbedUrl =
  `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
---

<section
  class="relative overflow-hidden bg-white pb-14 pt-20 md:pb-20 md:pt-24 dark:bg-slate-900"
  id="como-empezar"
>
  <!-- DECORACIÓN -->
  <div
    class="pointer-events-none absolute inset-0"
    aria-hidden="true"
  >
    <div
      class="absolute -left-24 top-1/3 hidden h-72 w-72 rounded-full bg-primary/5 blur-[100px] md:block"
    ></div>

    <div
      class="absolute -right-24 top-1/2 hidden h-72 w-72 rounded-full bg-[#7000ff]/[0.06] blur-[110px] md:block"
    ></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-5 sm:px-6">

    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <div class="mx-auto mb-10 max-w-3xl text-center md:mb-14">
      <span
        class="inline-flex items-center rounded-full border border-primary/20 bg-primary/5 px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-[#9d007d]"
      >
        Fácil y sin complicaciones
      </span>

      <h2
        class="mt-5 text-4xl font-black uppercase leading-tight text-slate-900 dark:text-white md:text-5xl"
      >
        Cómo
        <span class="tracking-tighter text-primary">
          Empezar
        </span>
      </h2>

      <p
        class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-500 dark:text-slate-400 md:text-lg"
      >
        Mira cómo funciona BeTogether y descubre lo fácil que es comenzar.
      </p>
    </div>

    <!-- ===================================================== -->
    <!-- VIDEO -->
    <!-- ===================================================== -->

    <div class="mx-auto mb-20 max-w-5xl">

      <button
        type="button"
        data-como-empezar-video-open
        aria-haspopup="dialog"
        aria-controls="como-empezar-video-modal"
        class="group relative block w-full overflow-hidden rounded-[1.75rem] border border-slate-200 bg-[#171126] text-left shadow-[0_18px_50px_rgba(15,23,42,0.14)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_65px_rgba(15,23,42,0.20)] focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/25 md:rounded-[2.25rem]"
      >
        <div
          class="relative aspect-video w-full overflow-hidden"
        >
          <!-- IMAGEN -->
          <img
            src={`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`}
            alt="Cómo funciona BeTogether"
            loading="lazy"
            width="1280"
            height="720"
            class="absolute inset-0 z-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.025]"
          />

          <!-- OVERLAY -->
          <div
            class="absolute inset-0 z-10 bg-gradient-to-t from-[#10091d]/75 via-[#171126]/15 to-black/5"
          ></div>

          <!-- PLAY CENTRAL -->
          <div
            class="absolute inset-0 z-30 flex items-center justify-center"
          >
            <div
              class="relative flex h-[76px] w-[76px] items-center justify-center rounded-full bg-white shadow-[0_12px_40px_rgba(0,0,0,0.28)] transition-all duration-300 group-hover:scale-110 sm:h-20 sm:w-20 md:h-24 md:w-24"
            >
              <!-- PULSO -->
              <span
                class="absolute inset-0 -z-10 rounded-full bg-white/30 opacity-0 transition-all duration-300 group-hover:scale-125 group-hover:opacity-100"
              ></span>

              <Play
                class="ml-1 h-8 w-8 fill-primary text-primary md:h-10 md:w-10"
              />
            </div>
          </div>

          <!-- ETIQUETA SUPERIOR -->
          <div
            class="absolute left-4 top-4 z-30 sm:left-6 sm:top-6"
          >
            <span
              class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-black/25 px-3 py-2 text-[10px] font-bold uppercase tracking-[0.14em] text-white backdrop-blur-sm sm:text-xs"
            >
              <span
                class="h-2 w-2 rounded-full bg-[#ff00c8]"
              ></span>

              Video explicativo
            </span>
          </div>

          <!-- CTA INFERIOR -->
          <div
            class="absolute bottom-4 left-4 z-30 sm:bottom-6 sm:left-6"
          >
            <span
              class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-4 py-2.5 text-sm font-bold text-white backdrop-blur-sm transition-all duration-300 group-hover:bg-white group-hover:text-[#171126]"
            >
              <Play
                class="h-4 w-4 fill-current"
              />
              Ver video
            </span>
          </div>
        </div>
      </button>

      <!-- TEXTO FUERA DE LA IMAGEN -->
      <div
        class="mx-auto mt-5 max-w-3xl text-center"
      >
        <h3
          class="text-xl font-extrabold text-slate-900 dark:text-white md:text-2xl"
        >
          Descubre cómo funciona BeTogether
        </h3>

        <p
          class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400 md:text-base"
        >
          Tu tienda, tus pagos y tus entregas desde un solo lugar.
        </p>
      </div>
    </div>

    <!-- ===================================================== -->
    <!-- PASOS -->
    <!-- ===================================================== -->

    <div
      class="relative grid gap-14 md:grid-cols-3 md:gap-12"
    >
      <!-- LÍNEA -->
      <div
        class="absolute left-1/4 right-1/4 top-12 z-0 hidden h-0.5 bg-slate-200 dark:bg-slate-800 md:block"
      ></div>

      <!-- PASO 01 -->
      <div
        class="group relative z-10 flex flex-col items-center text-center"
      >
        <div
          class="mb-7 flex h-24 w-24 items-center justify-center rounded-full border-4 border-white bg-background-light shadow-xl transition-all duration-300 group-hover:bg-primary group-hover:text-white dark:border-slate-900 dark:bg-slate-800"
        >
          <span
            class="text-3xl font-black text-slate-900 group-hover:text-white dark:text-white"
          >
            01
          </span>
        </div>

        <h3
          class="mb-4 text-xl font-bold text-slate-900 dark:text-white"
        >
          Regístrate Ahora
        </h3>

        <p
          class="max-w-sm leading-relaxed text-slate-500 dark:text-slate-400"
        >
          Regístrate en nuestro programa pionero en menos de 2 minutos.
          Sin cargos ocultos.
        </p>
      </div>

      <!-- PASO 02 -->
      <div
        class="group relative z-10 flex flex-col items-center text-center"
      >
        <div
          class="mb-7 flex h-24 w-24 items-center justify-center rounded-full border-4 border-white bg-background-light shadow-xl transition-all duration-300 group-hover:bg-brand-blue dark:border-slate-900 dark:bg-slate-800"
        >
          <span
            class="text-3xl font-black text-slate-900 group-hover:text-primary dark:text-white"
          >
            02
          </span>
        </div>

        <h3
          class="mb-4 text-xl font-bold text-slate-900 dark:text-white"
        >
          Promociona Productos
        </h3>

        <p
          class="max-w-sm leading-relaxed text-slate-500 dark:text-slate-400"
        >
          Escoge entre diferentes plantillas y usa herramientas como
          control de inventarios, logística y ventas.
        </p>
      </div>

      <!-- PASO 03 -->
      <div
        class="group relative z-10 flex flex-col items-center text-center"
      >
        <div
          class="mb-7 flex h-24 w-24 items-center justify-center rounded-full border-4 border-white bg-background-light shadow-xl transition-all duration-300 group-hover:bg-green-500 dark:border-slate-900 dark:bg-slate-800"
        >
          <span
            class="text-3xl font-black text-slate-900 group-hover:text-white dark:text-white"
          >
            03
          </span>
        </div>

        <h3
          class="mb-4 text-xl font-bold text-slate-900 dark:text-white"
        >
          Gana y Escala
        </h3>

        <p
          class="max-w-sm leading-relaxed text-slate-500 dark:text-slate-400"
        >
          Recibe pagos semanales y sube en el ranking para convertirte
          en un Afiliado Estrella.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ======================================================== -->
<!-- MODAL NATIVO -->
<!-- TOP LAYER: evita problemas de z-index/content-visibility -->
<!-- ======================================================== -->

<dialog
  id="como-empezar-video-modal"
  data-como-empezar-video-modal
  aria-labelledby="como-empezar-video-title"
  class="m-auto w-[calc(100%-1.5rem)] max-w-5xl overflow-visible rounded-[1.5rem] border-0 bg-transparent p-0 shadow-none backdrop:bg-[#08050f]/90 backdrop:backdrop-blur-sm sm:w-[calc(100%-2rem)] md:rounded-[2rem]"
>
  <div
    class="relative w-full overflow-hidden rounded-[1.5rem] border border-white/10 bg-[#110a1d] shadow-[0_30px_100px_rgba(0,0,0,0.65)] md:rounded-[2rem]"
  >
    <!-- HEADER -->
    <div
      class="flex min-h-[64px] items-center justify-between gap-4 border-b border-white/10 bg-[#171126] px-4 py-3 sm:px-5"
    >
      <div class="min-w-0">
        <p
          class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#ff7de4]"
        >
          BeTogether
        </p>

        <h3
          id="como-empezar-video-title"
          class="mt-0.5 truncate text-sm font-bold text-white sm:text-base"
        >
          Cómo funciona
        </h3>
      </div>

      <button
        type="button"
        data-como-empezar-video-close
        aria-label="Cerrar video"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white transition-all duration-200 hover:scale-105 hover:bg-white/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50"
      >
        <X class="h-5 w-5" />
      </button>
    </div>

    <!-- VIDEO -->
    <div
      class="relative aspect-video w-full overflow-hidden bg-black"
      data-como-empezar-video-container
      data-video-src={videoEmbedUrl}
    ></div>
  </div>
</dialog>

<script is:inline>
(() => {
  if (window.__beTogetherComoEmpezarVideoBound) {
    return;
  }

  window.__beTogetherComoEmpezarVideoBound = true;

  const modal =
    document.querySelector(
      "[data-como-empezar-video-modal]"
    );

  const container =
    document.querySelector(
      "[data-como-empezar-video-container]"
    );

  const openButtons =
    document.querySelectorAll(
      "[data-como-empezar-video-open]"
    );

  const closeButton =
    document.querySelector(
      "[data-como-empezar-video-close]"
    );

  if (
    !(modal instanceof HTMLDialogElement) ||
    !(container instanceof HTMLElement)
  ) {
    return;
  }

  let lastFocusedElement = null;

  const createIframe = () => {
    if (container.querySelector("iframe")) {
      return;
    }

    const src =
      container.dataset.videoSrc;

    if (!src) {
      return;
    }

    const iframe =
      document.createElement("iframe");

    iframe.src = src;

    iframe.title =
      "Cómo funciona BeTogether";

    iframe.allow =
      "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";

    iframe.allowFullscreen = true;

    iframe.referrerPolicy =
      "strict-origin-when-cross-origin";

    iframe.className =
      "absolute inset-0 h-full w-full border-0";

    container.appendChild(iframe);
  };

  const removeIframe = () => {
    const iframe =
      container.querySelector("iframe");

    if (iframe) {
      iframe.remove();
    }
  };

  const openModal = (trigger) => {
    lastFocusedElement = trigger;

    if (!modal.open) {
      modal.showModal();
    }

    document.documentElement.classList.add(
      "overflow-hidden"
    );

    document.body.classList.add(
      "overflow-hidden"
    );

    createIframe();

    requestAnimationFrame(() => {
      if (closeButton instanceof HTMLElement) {
        closeButton.focus();
      }
    });
  };

  const closeModal = () => {
    if (modal.open) {
      modal.close();
    }
  };

  openButtons.forEach((button) => {
    button.addEventListener(
      "click",
      () => openModal(button)
    );
  });

  if (closeButton) {
    closeButton.addEventListener(
      "click",
      closeModal
    );
  }

  /*
   * Cerrar haciendo clic en el backdrop.
   * El dialog ocupa solo el contenido visual,
   * por lo que cualquier clic sobre el propio
   * dialog fuera del panel se interpreta como backdrop.
   */
  modal.addEventListener(
    "click",
    (event) => {
      if (event.target === modal) {
        closeModal();
      }
    }
  );

  /*
   * ESC nativo del dialog.
   */
  modal.addEventListener(
    "cancel",
    () => {
      removeIframe();

      document.documentElement.classList.remove(
        "overflow-hidden"
      );

      document.body.classList.remove(
        "overflow-hidden"
      );
    }
  );

  modal.addEventListener(
    "close",
    () => {
      removeIframe();

      document.documentElement.classList.remove(
        "overflow-hidden"
      );

      document.body.classList.remove(
        "overflow-hidden"
      );

      if (
        lastFocusedElement instanceof HTMLElement
      ) {
        lastFocusedElement.focus();
      }
    }
  );
})();
</script>