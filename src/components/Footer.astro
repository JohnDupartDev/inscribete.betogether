---
import {
    Instagram,
    MessageCircle,
    Facebook,
    Linkedin,
    Music2,
} from "lucide-astro";

const currentYear = new Date().getFullYear();

const whatsappNumber = "573155870958";

const whatsappMessage =
    "Hola, me gustaría más información sobre BeTogether.";

const whatsappUrl =
    `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<footer
    class="relative bg-gradient-to-br from-[#1c1c2e] to-[#2d1f4e] px-5 pt-14 md:pt-16"
>
    <div class="mx-auto max-w-7xl">

        <!-- ========================================================= -->
        <!-- GRID PRINCIPAL -->
        <!-- ========================================================= -->

        <div
            class="grid grid-cols-1 gap-10 pb-10 md:grid-cols-2 md:gap-10 lg:grid-cols-[2fr_1fr_1fr] lg:gap-16"
        >

            <!-- ===================================================== -->
            <!-- MARCA -->
            <!-- ===================================================== -->

            <div
                class="mx-auto max-w-sm text-center md:col-span-2 lg:col-span-1 lg:mx-0 lg:text-left"
            >
                <a
                    href="/"
                    class="mb-4 inline-block transition-opacity duration-300 hover:opacity-80"
                    aria-label="Ir al inicio de BeTogether"
                >
                    <img
                        src="/logobetogether.svg"
                        alt="Better Together"
                        class="mx-auto h-[60px] w-auto lg:mx-0"
                        loading="lazy"
                        decoding="async"
                    />
                </a>

                <p
                    class="mx-auto mb-5 max-w-xs text-sm italic leading-6 text-white/70 lg:mx-0"
                >
                    Potenciando al talento creativo de Colombia.
                </p>

                <!-- REDES SOCIALES -->

                <div
                    class="flex flex-wrap justify-center gap-3 lg:justify-start"
                >

                    <!-- Facebook -->

                    <a
                        href="https://www.facebook.com/profile.php?id=61577098046804"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook"
                        class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white/80 transition-all duration-300 hover:-translate-y-1 hover:bg-gradient-to-br hover:from-[#ff00c8] hover:to-[#7000ff] hover:text-white"
                    >
                        <Facebook class="h-[18px] w-[18px]" />
                    </a>

                    <!-- TikTok -->

                    <a
                        href="https://www.tiktok.com/@betogethercol"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="TikTok"
                        class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white/80 transition-all duration-300 hover:-translate-y-1 hover:bg-gradient-to-br hover:from-[#ff00c8] hover:to-[#7000ff] hover:text-white"
                    >
                        <Music2 class="h-[18px] w-[18px]" />
                    </a>

                    <!-- Instagram -->

                    <a
                        href="https://www.instagram.com/betogethercol/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                        class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white/80 transition-all duration-300 hover:-translate-y-1 hover:bg-gradient-to-br hover:from-[#ff00c8] hover:to-[#7000ff] hover:text-white"
                    >
                        <Instagram class="h-[18px] w-[18px]" />
                    </a>

                    <!-- LinkedIn -->

                    <a
                        href="https://www.linkedin.com/company/be-togethercol/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="LinkedIn"
                        class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white/80 transition-all duration-300 hover:-translate-y-1 hover:bg-gradient-to-br hover:from-[#ff00c8] hover:to-[#7000ff] hover:text-white"
                    >
                        <Linkedin class="h-[18px] w-[18px]" />
                    </a>
                </div>
            </div>

            <!-- ===================================================== -->
            <!-- PLATAFORMA -->
            <!-- ===================================================== -->

            <div class="text-center lg:text-left">
                <h4
                    class="mb-5 text-base font-semibold text-white"
                >
                    Plataforma
                </h4>

                <ul class="space-y-3">
                    <li>
                        <a
                            href="https://www.betogether.com.co/marketplace"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block text-sm text-white/70 transition-all duration-300 hover:text-[#ff00c8] lg:hover:translate-x-1"
                        >
                            Marketplace
                        </a>
                    </li>

                    <li>
                        <a
                            href="https://www.betogether.com.co/logistica"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block text-sm text-white/70 transition-all duration-300 hover:text-[#ff00c8] lg:hover:translate-x-1"
                        >
                            Logística
                        </a>
                    </li>

                    <li>
                        <a
                            href="https://www.betogether.com.co/planes"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block text-sm text-white/70 transition-all duration-300 hover:text-[#ff00c8] lg:hover:translate-x-1"
                        >
                            Planes
                        </a>
                    </li>

                    <li>
                        <a
                            href="https://www.betogether.com.co/eventos"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block text-sm text-white/70 transition-all duration-300 hover:text-[#ff00c8] lg:hover:translate-x-1"
                        >
                            Eventos
                        </a>
                    </li>

                    <li>
                        <a
                            href="https://www.betogether.com.co/register"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block text-sm text-white/70 transition-all duration-300 hover:text-[#ff00c8] lg:hover:translate-x-1"
                        >
                            Registrarse
                        </a>
                    </li>
                </ul>
            </div>

            <!-- ===================================================== -->
            <!-- COMPAÑÍA -->
            <!-- ===================================================== -->

            <div class="text-center lg:text-left">
                <h4
                    class="mb-5 text-base font-semibold text-white"
                >
                    Compañía
                </h4>

                <ul class="space-y-3">
                    <li>
                        <a
                            href="https://www.betogether.com.co/sobre-nosotros"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block text-sm text-white/70 transition-all duration-300 hover:text-[#ff00c8] lg:hover:translate-x-1"
                        >
                            Sobre nosotros
                        </a>
                    </li>

                    <li>
                        <a
                            href="https://www.betogether.com.co/contacto"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block text-sm text-white/70 transition-all duration-300 hover:text-[#ff00c8] lg:hover:translate-x-1"
                        >
                            Contacto
                        </a>
                    </li>

                    <li>
                        <a
                            href="https://www.betogether.com.co/register/courier"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block text-sm text-white/70 transition-all duration-300 hover:text-[#ff00c8] lg:hover:translate-x-1"
                        >
                            Únete como repartidor
                        </a>
                    </li>

                    <li>
                        <a
                            href="https://www.betogether.com.co/terminos-y-condiciones"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block text-sm text-white/70 transition-all duration-300 hover:text-[#ff00c8] lg:hover:translate-x-1"
                        >
                            Términos y Condiciones
                        </a>
                    </li>

                    <li>
                        <a
                            href="https://www.betogether.com.co/politica-de-privacidad"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block text-sm text-white/70 transition-all duration-300 hover:text-[#ff00c8] lg:hover:translate-x-1"
                        >
                            Política de Privacidad
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- COPYRIGHT -->
        <!-- ========================================================= -->

        <div
            class="border-t border-white/10 py-6 text-center"
        >
            <p
                class="m-0 text-xs leading-relaxed text-white/50 sm:text-sm"
            >
                © {currentYear}
                <strong class="font-semibold">
                    Better Together COMPANY.
                </strong>
                Todos los derechos reservados.
            </p>
        </div>
    </div>
</footer>

<!-- ============================================================= -->
<!-- WHATSAPP FLOTANTE -->
<!-- ============================================================= -->

<a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar a BeTogether por WhatsApp"
    class="group fixed bottom-4 right-4 z-[1000] flex h-14 w-14 items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#25D366] to-[#128C7E] text-white shadow-[0_6px_20px_rgba(37,211,102,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-[1.03] hover:shadow-[0_12px_28px_rgba(37,211,102,0.45)] active:translate-y-0 active:scale-95 sm:bottom-6 sm:right-6 sm:h-auto sm:w-auto sm:px-5 sm:py-3"
>
    <MessageCircle
        class="h-6 w-6 shrink-0 sm:h-5 sm:w-5"
    />

    <span
        class="hidden whitespace-nowrap text-sm font-semibold sm:inline"
    >
        Contáctanos vía WhatsApp
    </span>
</a>